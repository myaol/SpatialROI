plot_signature <- function(meta_df, feature, title_text, y_quantiles = c(0.01, 0.99)) {
fill_colors <- c(
"normal_young" = "#6baed6",
"normal_old"   = "#fdae6b",
"covid_young"  = "#2171b5",
"covid_old"    = "tan2"
)
border_colors <- colorspace::darken(fill_colors, 0.4)
vals <- meta_df[[feature]]
y_lo <- quantile(vals, y_quantiles[1], na.rm = TRUE)
y_hi <- quantile(vals, y_quantiles[2], na.rm = TRUE)
y_range <- y_hi - y_lo
# Stagger label.y for each comparison to avoid overlap
label_y_vals <- y_hi + y_range * c(0.15, 0.30)
y_max_plot   <- y_hi + y_range * 0.45  # extra room for brackets
ggplot(meta_df, aes(x = group, y = .data[[feature]], fill = group)) +
geom_violin(trim = TRUE, scale = "width", alpha = 0.95, color = NA) +
geom_boxplot(
width = 0.15,
outlier.shape = NA,
aes(color = group),
fill = NA
) +
stat_compare_means(
comparisons = comparisons,
method      = "wilcox.test",
label       = "p.signif",
hide.ns     = TRUE,
label.y     = label_y_vals
) +
scale_fill_manual(values = fill_colors) +
scale_color_manual(values = border_colors) +
scale_y_continuous(limits = c(y_lo, y_max_plot)) +  # clips violins, keeps brackets
theme_classic(base_size = 14) +
theme(
axis.text.x = element_text(angle = 45, hjust = 1, face = "bold"),
legend.position = "none"
) +
labs(
y     = paste0(feature, " Score"),
title = title_text
)
}
p1 <- plot_signature(meta_df, "Inflammatory1", "Inflammatory Response: Normal vs COVID")
p2 <- plot_signature(meta_df, "Influenza1",    "Influenza Signature: Normal vs COVID")
print(p1)
plot_signature <- function(meta_df, feature, title_text, y_quantiles = c(0.01, 0.99)) {
fill_colors <- c(
"normal_young" = "#6baed6",
"normal_old"   = "#fdae6b",
"covid_young"  = "#2171b5",
"covid_old"    = "tan2"
)
border_colors <- colorspace::darken(fill_colors, 0.4)
vals  <- meta_df[[feature]]
y_lo  <- quantile(vals, y_quantiles[1], na.rm = TRUE)
y_hi  <- quantile(vals, y_quantiles[2], na.rm = TRUE)
y_range <- y_hi - y_lo
# Place brackets just inside the cartesian window
label_y_vals <- c(y_hi + y_range * 0.05,
y_hi + y_range * 0.20)
cart_y_max   <- y_hi + y_range * 0.35
ggplot(meta_df, aes(x = group, y = .data[[feature]], fill = group)) +
geom_violin(trim = TRUE, scale = "width", alpha = 0.95, color = NA) +
geom_boxplot(
width = 0.15, outlier.shape = NA,
aes(color = group), fill = NA
) +
stat_compare_means(
comparisons = comparisons,
method      = "wilcox.test",
label       = "p.signif",
hide.ns     = FALSE,       # show all including ns to debug
label.y     = label_y_vals,
tip.length  = 0.01
) +
coord_cartesian(ylim = c(y_lo, cart_y_max)) +
scale_fill_manual(values = fill_colors) +
scale_color_manual(values = border_colors) +
theme_classic(base_size = 14) +
theme(
axis.text.x = element_text(angle = 45, hjust = 1, face = "bold"),
legend.position = "none"
) +
labs(y = paste0(feature, " Score"), title = title_text)
}
p1 <- plot_signature(meta_df, "Inflammatory1", "Inflammatory Response: Normal vs COVID")
p2 <- plot_signature(meta_df, "Influenza1",    "Influenza Signature: Normal vs COVID")
print(p1)
print(p2)
comparisons <- list(
c("normal_young", "normal_old"),
c("normal_young", "covid_young")
)
plot_signature <- function(meta_df, feature, title_text, y_quantiles = c(0.01, 0.99)) {
fill_colors <- c(
"normal_young" = "#6baed6",
"normal_old"   = "#fdae6b",
"covid_young"  = "#2171b5",
"covid_old"    = "tan2"
)
border_colors <- colorspace::darken(fill_colors, 0.4)
vals  <- meta_df[[feature]]
y_lo  <- quantile(vals, y_quantiles[1], na.rm = TRUE)
y_hi  <- quantile(vals, y_quantiles[2], na.rm = TRUE)
y_range <- y_hi - y_lo
# Place brackets just inside the cartesian window
label_y_vals <- c(y_hi + y_range * 0.08,   # comparison 1: adjacent groups
y_hi + y_range * 0.28)
cart_y_max   <- y_hi + y_range * 0.50
ggplot(meta_df, aes(x = group, y = .data[[feature]], fill = group)) +
geom_violin(trim = TRUE, scale = "width", alpha = 0.95, color = NA) +
geom_boxplot(
width = 0.15, outlier.shape = NA,
aes(color = group), fill = NA
) +
stat_compare_means(
comparisons = comparisons,
method      = "wilcox.test",
label       = "p.signif",
hide.ns     = FALSE,       # show all including ns to debug
label.y     = label_y_vals,
tip.length  = 0.01
) +
coord_cartesian(ylim = c(y_lo, cart_y_max)) +
scale_fill_manual(values = fill_colors) +
scale_color_manual(values = border_colors) +
theme_classic(base_size = 14) +
theme(
axis.text.x = element_text(angle = 45, hjust = 1, face = "bold"),
legend.position = "none"
) +
labs(y = paste0(feature, " Score"), title = title_text)
}
p1 <- plot_signature(meta_df, "Inflammatory1", "Inflammatory Response: Normal vs COVID")
p2 <- plot_signature(meta_df, "Influenza1",    "Influenza Signature: Normal vs COVID")
print(p1)
library(Seurat)
library(ggplot2)
library(dplyr)
library(ComplexHeatmap)
library(circlize)
## if you are using the human cohort
# ---- Load and merge ----
seurat_normal <- readRDS("/Users/markdana/Downloads/4cb45d80-499a-48ae-a056-c71ac3552c94_after_QC_normalized_noambeintRNA_AM_only.rds")
seurat_covid  <- readRDS("/Users/markdana/Downloads/cd9ac225-682a-4f39-b0de-29caeb532bec_COVID_only_AM_only.rds")
seurat_normal$condition <- "normal"
seurat_covid$condition  <- "covid"
obj <- merge(seurat_normal, seurat_covid)
# ---- Age processing ----
obj$age <- suppressWarnings(as.numeric(obj$age_or_mean_of_age_range))
obj$age_group <- "middle"
obj$age_group[obj$age < 40] <- "young"
obj$age_group[obj$age >= 60] <- "old"
obj <- subset(obj, subset = age_group %in% c("young", "old"))
# ---- Create group ----
obj$group <- paste(obj$condition, obj$age_group, sep = "_")
obj$group <- factor(obj$group,
levels = c("normal_young", "normal_old",
"covid_young", "covid_old"))
# ---- Use this object ----
obj_neut <- obj
# ---- Set identity ----
Idents(obj_neut) <- "group"
# ---- Check ----
table(Idents(obj_neut))
## human label genes start from here
top20_per_group <- read.csv(
"/Users/markdana/Downloads/AM_human_top20DEG_1vsall_genes_to_plot.csv"
)
head(top20_per_group)
additional_genes <- c(
"HSPA1A", "FOS", "MMP15", "CXCL12", "SOX4",
"HSPA1B", "RSAD2", "GPX1", "ISG20",
"HBA1", "HBA2", "HBB",
"ISG15", "IFIT3", "IRF7", "OAS2", "ZBP1"
)
genes_to_plot <- unique(c(top20_per_group$gene, additional_genes))
genes_to_plot <- genes_to_plot[genes_to_plot %in% rownames(obj_neut)]
# ---- Calculate average expression ----
avg_exp <- AverageExpression(
obj_neut,
features = genes_to_plot,
group.by = "group", ## change to group.by = "group" for human otherwise day_age
slot = "counts" ## for mouse use slot = "data"
)
# exp_matrix <- as.matrix(avg_exp$decontX)
## this is the most robust way
exp_matrix <- as.matrix(avg_exp[[1]])
# Replace hyphens with underscores in column names
colnames(exp_matrix) <- gsub("-", "_", colnames(exp_matrix))
# Scale the expression (Z-score by gene)
exp_matrix_scaled <- t(scale(t(exp_matrix)))
exp_matrix_scaled[is.na(exp_matrix_scaled)] <- 0
# for the human use this:
column_order <- c("normal_young", "normal_old",
"covid_young", "covid_old")
column_order <- column_order[column_order %in% colnames(exp_matrix_scaled)]
exp_matrix_scaled <- exp_matrix_scaled[, column_order]
# ---- Convert to data frame ----
exp_matrix_scaled <- as.data.frame(exp_matrix_scaled)
## the human ones need label use this:
genes_to_label_all <- c(
# Stress response / immediate early genes
"HSPA1A", "HSPA1B", "FOS", "GPX1", "SOX4",
# Chemotaxis / migration / tissue remodeling
"MMP15", "CXCL12",
# Antiviral / interferon response
"RSAD2", "ISG20", "ISG15", "IFIT3",
"IRF7", "OAS2", "ZBP1",
# Erythroid / hemoglobin-related
"HBA1", "HBA2", "HBB"
)
# ---- Find labeled gene indices ----
allnames <- rownames(exp_matrix_scaled)
index_w_genes <- match(genes_to_label, allnames)
index_w_genes <- index_w_genes[!is.na(index_w_genes)]
genes_to_label <- genes_to_label[genes_to_label %in% allnames]
## the human ones need label use this:
genes_to_label <- c(
# Stress response / immediate early genes
"HSPA1A", "HSPA1B", "FOS", "GPX1", "SOX4",
# Chemotaxis / migration / tissue remodeling
"MMP15", "CXCL12",
# Antiviral / interferon response
