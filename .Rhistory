"IRF7", "OAS2", "ZBP1",
# Erythroid / hemoglobin-related
"HBA1", "HBA2", "HBB"
)
# ---- Find labeled gene indices ----
allnames <- rownames(exp_matrix_scaled)
index_w_genes <- match(genes_to_label, allnames)
index_w_genes <- index_w_genes[!is.na(index_w_genes)]
genes_to_label <- genes_to_label[genes_to_label %in% allnames]
# ---- Create column annotation ----
col_annotation <- data.frame(
Day = gsub("_.*", "", colnames(exp_matrix_scaled)),
Age = gsub(".*_", "", colnames(exp_matrix_scaled)),
row.names = colnames(exp_matrix_scaled)
)
## human ones use this:
col_annotation <- data.frame(
Condition = gsub("_.*", "", colnames(exp_matrix_scaled)),
Age = gsub(".*_", "", colnames(exp_matrix_scaled)),
row.names = colnames(exp_matrix_scaled)
)
## human ones use this:
condition_colors <- c(
"normal" = "#4DBBD5",
"covid"  = "#E64B35"
)
age_colors <- c(
"young" = "#3B9AB2",
"old"   = "#E84646"
)
col_annotation$Condition <- factor(
col_annotation$Condition,
levels = c("normal", "covid")
)
col_annotation$Age <- factor(
col_annotation$Age,
levels = c("young", "old")
)
col_annotation <- data.frame(
Day = sub("_.*", "", colnames(exp_matrix_scaled)),
Age = sub(".*_", "", colnames(exp_matrix_scaled)),
row.names = colnames(exp_matrix_scaled)
)
ra <- rowAnnotation(
foo = anno_mark(
at = index_w_genes,
labels = genes_to_label,
labels_gp = gpar(fontsize = 10),
padding = unit(1, "mm")
)
)
group.by = "day_age"
#---- Create color mapping ----
min_val <- min(exp_matrix_scaled, na.rm = TRUE)
max_val <- max(exp_matrix_scaled, na.rm = TRUE)
colors_100 <- colorRampPalette(c("blue", "white", "red"))(100)
breaks_100 <- seq(min_val, max_val, length.out = 100)
col_fun <- colorRamp2(breaks_100, colors_100)
exp_matrix_scaled <- as.matrix(exp_matrix_scaled)
pdf("/Users/markdana/Downloads/human_AM_DEGs_heatmap_day_age_labeled.pdf",
width = 6, height = 7)
h <- Heatmap(
exp_matrix_scaled,
name = "z-score",
col = col_fun,
cluster_rows = TRUE,
cluster_columns = FALSE,
row_split = factor(km$cluster),
show_row_names = FALSE,
right_annotation = NULL,
show_column_names = TRUE,
column_names_rot = 45,
column_names_gp = gpar(fontsize = 12),
border = TRUE,
column_title = "Top 20 DEGs per Group (Monocytes)",
column_title_gp = gpar(fontsize = 14, fontface = "bold")
)
draw(
h,
heatmap_legend_side = "right",
annotation_legend_side = "right",
merge_legend = TRUE
)
dev.off()
# ---- Stable K-means clustering ----
set.seed(123)
km <- kmeans(exp_matrix_scaled, centers = 4, nstart = 10)
# ---- Save gene cluster info ----
gene_clusters <- data.frame(
Gene = rownames(exp_matrix_scaled),
Cluster = km$cluster,
Is_Labeled = ifelse(
rownames(exp_matrix_scaled) %in% genes_to_label,
"Yes",
"No"
)
) %>%
left_join(
all_markers %>%
select(gene, cluster, avg_log2FC, pct.1, pct.2, p_val, p_val_adj) %>%
rename(Gene = gene, DEG_Group = cluster),
by = "Gene"
) %>%
arrange(Cluster, Gene)
