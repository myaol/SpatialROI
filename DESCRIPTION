Package: SpatialROI
Title: An Interactive R Shiny Platform for Customized Region-Aware Spatial Transcriptomics Analysis
Version: 0.1.0
Authors@R: c(
    person("Mengyao", "Lu",
           email = "mel373@pitt.edu",
           role = c("aut", "cre"),
